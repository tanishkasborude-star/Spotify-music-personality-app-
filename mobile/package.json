{
  "name": "spotify-personality-companion",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "build:android": "npx eas-cli build --platform android --profile production",
    "build:all": "npx eas-cli build --platform all --profile production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/ui": "~58.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.16",
    "expo-auth-session": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-secure-store": "~58.0.2",
    "expo-web-browser": "~58.0.6",
    "expo-widgets": "~58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
