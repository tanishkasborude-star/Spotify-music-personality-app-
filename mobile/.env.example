# `mock` gives you a complete local sign-in experience without credentials.
# Set to `supabase` to use the configured Supabase project.
EXPO_PUBLIC_AUTH_MODE=mock
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Spotify Developer Dashboard application client ID (never put a client secret here).
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
# Must match a Redirect URI registered in Spotify's app settings.
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=
