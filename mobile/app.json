{
  "expo": {
    "name": "Spotify Personality",
    "slug": "spotify-personality-companion",
    "owner": "tanishkasborude-star",
    "scheme": "spotify-personality",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "experiments": {
      "inlineModules": {
        "watchedDirectories": [
          "src/widgets/android"
        ]
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tanishkasborude.soundprint"
    },
    "android": {
      "package": "com.tanishkasborude.soundprint",
      "adaptiveIcon": {
        "backgroundColor": "#0D1210"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Spotify Personality"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.tanishkasborude.soundprint",
          "widgets": [
            {
              "name": "MusicPersonalityWidget",
              "displayName": "Music Personality",
              "description": "Your archetype and a song picked for you",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "src/widgets/MusicPersonalityWidget.tsx"
              }
            }
          ]
        }
      ],
      "./plugins/withAndroidMusicWidget",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.tanishkasborude.soundprint.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.tanishkasborude.soundprint"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "81891e57-6a26-4660-beb5-35c90b068f9b"
      }
    }
  }
}
